# ---------------------------------------------------------------------------
# Contact form delivery. Without RESEND_API_KEY the form returns an error and
# the page tells visitors to email Andres directly, so nothing is lost silently.
# ---------------------------------------------------------------------------

# Resend (resend.com -> API Keys)
RESEND_API_KEY=re_your_api_key

# The "from" address on both the lead notification and the courtesy reply.
# Until mycreativestrategist.com is verified in Resend, use the sandbox sender:
#   The Creative Strategist <onboarding@resend.dev>
# After verifying the domain, switch to:
#   Andres Diaz <andres@mycreativestrategist.com>
RESEND_FROM=The Creative Strategist <onboarding@resend.dev>

# Where the "new inquiry" notification lands.
NOTIFY_EMAIL=andres@mycreativestrategist.com
